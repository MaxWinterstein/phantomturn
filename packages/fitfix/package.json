  },
  "homepage": "https://github.com/MaxWinterstein/phantomturn#readme",
  "bugs": "https://github.com/MaxWinterstein/phantomturn/issues",
  "engines": {
    "node": ">=22"
  },
  "main": "src/swim-repair.js",
  "exports": {
